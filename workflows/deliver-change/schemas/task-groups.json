{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TaskGroups",
  "type": "object",
  "required": ["groups"],
  "properties": {
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "goal", "repository", "ticket_ids", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "goal": { "type": "string", "minLength": 1 },
          "repository": { "type": "string", "minLength": 1 },
          "ticket_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["group_id", "milestone"],
              "properties": {
                "group_id": { "type": "string" },
                "milestone": { "type": "string" }
              }
            }
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
