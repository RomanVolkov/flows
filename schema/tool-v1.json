{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flows.dev/schema/tool-v1.json",
  "title": "Flows Tool Manifest v1",
  "type": "object",
  "required": ["schema", "id", "version", "operations"],
  "additionalProperties": true,
  "properties": {
    "schema": {
      "type": "string",
      "const": "flows/tool/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "owner": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "help": {
      "type": "string"
    },
    "entry": {
      "type": "string"
    },
    "required_clis": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "credentials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "provider"],
        "properties": {
          "id": { "type": "string" },
          "provider": { "type": "string" },
          "required": { "type": "boolean" }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "execution_kind"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
          },
          "description": { "type": "string" },
          "help": { "type": "string" },
          "execution_kind": {
            "type": "string",
            "enum": ["command", "harness", "workflow", "plugin", "wait", "notify"]
          },
          "read_only": { "type": "boolean" },
          "input_schema": { "type": "object" },
          "output_schema": { "type": "object" },
          "milestones": {
            "type": "array",
            "items": { "type": "string" }
          },
          "prompts": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
