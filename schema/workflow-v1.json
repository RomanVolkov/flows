{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flows.dev/schema/workflow-v1.json",
  "title": "Flows Workflow Definition v1",
  "type": "object",
  "required": ["schema", "id", "version", "nodes"],
  "additionalProperties": true,
  "properties": {
    "schema": { "type": "string", "const": "flows/v1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "minLength": 1 },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "enum": ["string", "number", "integer", "boolean", "array", "object"] },
          "required": { "type": "boolean" },
          "default": {}
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": { "type": "string" }
    },
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "uses": { "type": "string" },
          "workflow": { "type": "string" },
          "when": { "type": "string" },
          "needs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "for_each": {
            "type": "object",
            "required": ["items", "key"],
            "properties": {
              "items": { "type": "string" },
              "key": { "type": "string" }
            }
          },
          "repeat": {
            "type": "object",
            "required": ["max"],
            "properties": {
              "max": { "type": "integer", "minimum": 1 },
              "until": { "type": "string" }
            }
          },
          "watch": {
            "type": "object",
            "required": ["interval", "deadline", "until"],
            "properties": {
              "interval": { "type": "string" },
              "deadline": { "type": "string" },
              "until": { "type": "string" },
              "cursor": { "type": "string" }
            }
          },
          "with": { "type": "object" },
          "outputs": { "type": "object" }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    }
  }
}
